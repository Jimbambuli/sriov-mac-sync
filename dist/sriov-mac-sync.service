[Unit]
Description=Keep an SR-IOV uplink's unicast filter in step with the bridge behind it
Documentation=https://github.com/Jimbambuli/sriov-mac-sync
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/sriov-mac-sync
Restart=always
RestartSec=5
KillMode=control-group

# It writes hardware filters and reads /sys; nothing else is needed.
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
# Which entries are ours is noted here. Keep it across a restart, or the
# daemon comes back unable to tell its own entries from anyone else's and
# stops cleaning up after itself. /run is a tmpfs, so a reboot still clears
# it - which is right, the card's filter is empty by then too.
RuntimeDirectory=sriov-mac-sync
RuntimeDirectoryPreserve=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
