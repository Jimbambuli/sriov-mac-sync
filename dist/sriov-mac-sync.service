[Unit]
Description=Keep an SR-IOV uplink's unicast filter in step with the bridge behind it
Documentation=https://github.com/Jimbambuli/sriov-mac-sync
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/sriov-mac-sync
# SIGHUP asks for a full pass that believes nothing carried (--resync).
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
KillMode=control-group

# It writes hardware filters and reads /sys; nothing else is needed. It stays
# uid 0 not for the capability - AmbientCapabilities below would hand
# CAP_NET_ADMIN to any User= - but for the notes: --once and --flush are run
# by hand as root and share the 0600 files in /run/sriov-mac-sync with the
# daemon, and a non-root daemon could neither read nor lock what they leave
# behind (notes.rs spells the same premise out). Everything below takes the
# rest of root away again.
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateDevices=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# Netlink - commands and the subscription - is the whole of its outside
# world.
RestrictAddressFamilies=AF_NETLINK
UMask=0077
# Which entries are ours is noted here. Keep it across a restart, or the
# daemon comes back unable to tell its own entries from anyone else's and
# stops cleaning up after itself. /run is a tmpfs, so a reboot still clears
# it - which is right, the card's filter is empty by then too.
RuntimeDirectory=sriov-mac-sync
# 0700 rather than the 0755 this defaults to. Nothing else has any business
# reading which addresses are registered, and a directory no other user may
# write is one no other user can put a symlink in for a root daemon to write
# through. The daemon narrows a directory it finds writable by others anyway;
# this means it never finds one.
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
