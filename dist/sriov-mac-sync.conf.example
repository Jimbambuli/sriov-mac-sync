# /etc/sriov-mac-sync.conf - all optional

# Uplink/bridge pairs to manage. Empty means autodetect: every interface with
# virtual functions that ends up in a bridge, following bonds.
#PAIRS="nic1:vmbr1 nic0:vmbr0"

# Seconds between full reconciliations. This is paranoia, not the mechanism.
# Addresses are registered the moment the kernel reports them, removed when the
# bridge ages them out, and interface changes - a new NIC, a new bridge, a VF
# whose address was set from the host - arrive as link notifications. The timed
# pass exists only in case one of those is ever missed.
#RESYNC=300

# Warn above this many addresses per uplink. The vport list on ConnectX-4 Lx
# holds 128; other hardware differs and the size cannot be queried.
#MAX_MACS=128

# Addresses never to register, comma or space separated.
#EXCLUDE=""

# Addresses to register unconditionally, for a device that never speaks first.
# The wire-side and own-address rules still override this.
#EXTRA=""
